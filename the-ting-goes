#!/bin/bash

if [[ "$1" == "-p" || "$1" == "--panic" ]]; then
    echo "THE FLAG -p (or --panic) IS GONNA CRASH YOUR KERNEL AFTER THE LOOP."
    read -p "ARE YOU SURE? [S/N] " confirm

    if [[ ! "$confirm" =~ ^[Ss]$ ]]; then
        echo "Cancelled."
        exit 0
    fi
fi

lines=(
    "sexy"
    "no ketchup"
    "nah"
    "just sauce"
    "saucy"
    "(im not gonna write this)"
    "yo"
    "boom"
    "a- ah~"
    "the ting goes"
)

delays=(0.5 0.6 0.6 0.7 0.7 1.6 0.7 0.7 0.9 0.6)

for i in "${!lines[@]}"; do
    echo "${lines[$i]}"
    if command -v spd-say &>/dev/null; then
        spd-say -r 15 "${lines[$i]}"
    elif command -v espeak &>/dev/null; then
        espeak "${lines[$i]}" 2>/dev/null
    fi
    sleep "${delays[$i]}"
done

if [[ "$1" == "-p" || "$1" == "--panic" ]]; then
    sleep 0.5
    echo c | sudo tee /proc/sysrq-trigger >/dev/null
fi

kill -INT $$
